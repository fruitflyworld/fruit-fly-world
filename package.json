{
  "name": "fruit-fly-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "anchor": "tsx scripts/anchor.ts",
    "verify:anchors": "tsx scripts/verify-anchor.ts",
    "nand:table": "tsx scripts/nand/table.ts",
    "nand:synth": "python3 scripts/nand/synth.py",
    "nand:bytes": "tsx scripts/nand/tapeout.ts bytes",
    "nand:verify": "tsx scripts/nand/tapeout.ts verify",
    "nand:compare": "tsx scripts/nand/compare.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "film:capture": "node scripts/launch-film/capture.mjs",
    "film:render": "node scripts/launch-film/render.mjs",
    "film": "npm run film:capture && npm run film:render"
  },
  "dependencies": {
    "next": "14.2.35",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "siwe": "3.0.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
