NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_MINT_CONTRACT_ADDRESS=
DATABASE_URL=postgresql://fruitfly_app:CHANGE_ME@127.0.0.1:5432/fruit_fly_world
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_SECRET=CHANGE_TO_32_RANDOM_BYTES
MINT_VOUCHER_PRIVATE_KEY=
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The X_QUOTE mission reads posts through twitterapi.io. Without this key the
# mission cannot open: /api/missions/x/challenge stays closed, because a proof
# nobody can read is a proof nobody can grant. (X_API_KEY is still read as a
# fallback for the older variable name.)
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE=https://api.twitterapi.io
# The account a proof has to quote, for the post template. Overridden per
# campaign by mission_campaigns.official_x_post_id, which is what is checked.
X_HANDLE=fruitflyworld

# The Foraging Hour. ARENA_ENABLED=1 turns the arena on; while it is off every
# /api/arena route answers 404/disabled and the homepage section shows no clock.
ARENA_ENABLED=1
ARENA_WINDOW_SEC=3600
ARENA_PER_WINDOW_TRIES=8
# One Passport per address, so one win per wallet per rolling 24 hours.
ARENA_PER_WALLET_DAY=1
# The cap that actually bites: wallet addresses are free, IPs are not.
ARENA_PER_IP_DAY=4
